{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fmcgdms:lab-run-context-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "environmentId",
    "sourceHeadSha",
    "fixtureSha256",
    "configurationSha256",
    "startedUtc",
    "hostSha256",
    "mode"
  ],
  "properties": {
    "schema": {
      "const": "APP02B-LAB-RUN-CONTEXT-V1"
    },
    "runId": {
      "type": "string",
      "pattern": "^b-lab-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8,32}$"
    },
    "environmentId": {
      "type": "string",
      "pattern": "^lab-[a-z0-9][a-z0-9-]{0,39}$"
    },
    "sourceHeadSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "fixtureSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configurationSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "startedUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "hostSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "const": "LOCAL_OPERATOR_LAB"
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "context"
      ],
      "properties": {
        "state": {
          "const": "PREPARED"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "runId",
            "environmentId",
            "sourceHeadSha",
            "fixtureSha256",
            "configurationSha256",
            "startedUtc",
            "hostSha256",
            "mode"
          ],
          "properties": {
            "schema": {
              "const": "APP02B-LAB-RUN-CONTEXT-V1"
            },
            "runId": {
              "type": "string",
              "pattern": "^b-lab-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8,32}$"
            },
            "environmentId": {
              "type": "string",
              "pattern": "^lab-[a-z0-9][a-z0-9-]{0,39}$"
            },
            "sourceHeadSha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "fixtureSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "configurationSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "startedUtc": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "format": "date-time"
            },
            "hostSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "mode": {
              "const": "LOCAL_OPERATOR_LAB"
            }
          }
        }
      }
    }
  }
}
