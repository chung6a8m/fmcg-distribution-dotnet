{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidenceClassification", "authorization", "publisherProvenance", "engineFilesystemHeadroom", "collectedUtc", "sourceHead", "sourceState", "planSha256", "hostRef", "engineRef", "readiness", "issueCodes", "checks", "observed"],
  "properties": {
    "schema": {"const": "APP02B-LAB-DOCKER-HOST-PREFLIGHT-V1"},
    "evidenceClassification": {"const": "WINDOWS_HOST_PREFLIGHT"},
    "authorization": {"const": "NOT_EVALUATED"},
    "publisherProvenance": {"const": "OPERATOR_RECEIPT_DIGEST_BOUND"},
    "engineFilesystemHeadroom": {"const": "NOT_MEASURED"},
    "collectedUtc": {"type": "string", "format": "date-time"},
    "sourceHead": {
      "anyOf": [
        {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        {"type": "null"}
      ]
    },
    "sourceState": {
      "type": "string",
      "enum": ["CLEAN", "DIRTY", "UNKNOWN", "CHANGED_DURING_COLLECTION"]
    },
    "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hostRef": {
      "anyOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "engineRef": {
      "anyOf": [
        {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        {"type": "null"}
      ]
    },
    "readiness": {
      "type": "string",
      "enum": ["READY", "BLOCKED", "COLLECTION_FAILED"]
    },
    "issueCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["DOCKER_ENV_OVERRIDE", "UNSAFE_CONTEXT", "DAEMON_UNAVAILABLE", "UNSUPPORTED_DESKTOP_LAYOUT", "UNTRUSTED_PLUGIN_CONFIGURATION", "COLLECTION_ERROR", "HOST_ACCESS_DENIED"]
      },
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SOURCE", "WINDOWS", "POWERSHELL", "PYTHON", "GIT", "HOST_IDENTITY", "HOST_MEMORY", "HOST_DNS", "HOST_CLOCK", "WSL_VERSION", "WSL2_BACKEND", "DOCKER_DESKTOP", "DOCKER_CLI", "LOCAL_CONTEXT", "DOCKER_DAEMON", "ENGINE_IDENTITY", "LINUX_ENGINE", "SQL_X64", "WSL_MEMORY", "WINDOWS_BACKING_STORAGE", "COMPOSE", "PROJECT", "NETWORKS", "PORTS", "VOLUMES", "IMAGE_APP", "IMAGE_SQL", "IMAGE_VAULT", "IMAGE_PROXY"],
      "properties": {
        "SOURCE": {
          "type": "string",
          "enum": ["PASS", "FAIL", "UNKNOWN"]
        },
        "WINDOWS": {
          "type": "string",
          "enum": ["PASS", "FAIL", "UNKNOWN"]
        },
        "POWERSHELL": {
          "type": "string",
          "enum": ["PASS", "FAIL", "UNKNOWN"]
        },
        "PYTHON": {
          "type": "string",
          "enum": ["PASS", "FAIL", "UNKNOWN"]
        },
        "GIT": {
          "type": "string",
          "enum": ["PASS", "FAIL", "UNKNOWN"]
        },
        "HOST_IDENTITY": {
          "type": "string",
          "enum": ["PASS", "FAIL", "UNKNOWN"]
        },
        "HOST_MEMORY": {
          "type": "string",
