          "type": "string",
          "enum": ["PASS", "FAIL", "UNKNOWN"]
        },
        "IMAGE_PROXY": {
          "type": "string",
          "enum": ["PASS", "FAIL", "UNKNOWN"]
        }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windowsBuild", "hostArchitecture", "engineArchitecture", "wslMode", "versions", "storageDriver", "storageRef", "hostFreeRamMiB", "hostTotalRamMiB", "engineRamMiB", "engineCpu", "diskFreeMiB", "vhdCapacityMiB", "containerCount", "projectCount", "networkCount", "volumeCount", "bindCount", "publishedPortCount", "images"],
      "properties": {
        "windowsBuild": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "hostArchitecture": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["X64", "ARM64", "X86", "ARM"]
            },
            {"type": "null"}
          ]
        },
        "engineArchitecture": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["X64", "ARM64", "X86", "ARM"]
