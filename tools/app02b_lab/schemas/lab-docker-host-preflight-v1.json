            {"type": "null"}
          ]
        },
        "wslMode": {
          "anyOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["python", "git", "pwsh", "wsl", "desktop", "dockerCli", "engine", "compose"],
          "properties": {
            "python": {
              "anyOf": [
                {"type": "string", "pattern": "^[0-9]{1,6}(\\.[0-9]{1,6}){1,3}$"},
                {"type": "null"}
              ]
            },
            "git": {
              "anyOf": [
                {"type": "string", "pattern": "^[0-9]{1,6}(\\.[0-9]{1,6}){1,3}$"},
                {"type": "null"}
              ]
            },
            "pwsh": {
              "anyOf": [
                {"type": "string", "pattern": "^[0-9]{1,6}(\\.[0-9]{1,6}){1,3}$"},
                {"type": "null"}
              ]
            },
            "wsl": {
              "anyOf": [
                {"type": "string", "pattern": "^[0-9]{1,6}(\\.[0-9]{1,6}){1,3}$"},
                {"type": "null"}
              ]
            },
            "desktop": {
              "anyOf": [
                {"type": "string", "pattern": "^[0-9]{1,6}(\\.[0-9]{1,6}){1,3}$"},
                {"type": "null"}
              ]
            },
            "dockerCli": {
              "anyOf": [
                {"type": "string", "pattern": "^[0-9]{1,6}(\\.[0-9]{1,6}){1,3}$"},
                {"type": "null"}
              ]
            },
            "engine": {
              "anyOf": [
                {"type": "string", "pattern": "^[0-9]{1,6}(\\.[0-9]{1,6}){1,3}$"},
                {"type": "null"}
              ]
            },
            "compose": {
              "anyOf": [
                {"type": "string", "pattern": "^[0-9]{1,6}(\\.[0-9]{1,6}){1,3}$"},
                {"type": "null"}
              ]
            }
          }
        },
        "storageDriver": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["overlay2", "overlayfs"]
            },
            {"type": "null"}
          ]
        },
        "storageRef": {
          "anyOf": [
            {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            {"type": "null"}
          ]
        },
        "hostFreeRamMiB": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "hostTotalRamMiB": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "engineRamMiB": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "engineCpu": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "diskFreeMiB": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "vhdCapacityMiB": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "containerCount": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "projectCount": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "networkCount": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "volumeCount": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "bindCount": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "publishedPortCount": {
          "anyOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "sha256", "publisherReceiptSha256", "status"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["APP", "SQL", "VAULT", "PROXY"]
              },
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "publisherReceiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "status": {
                "type": "string",
                "enum": ["PASS", "FAIL", "UNKNOWN"]
              }
            }
          },
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true
        }
      }
