              "SQL_X64": {"const": "PASS"},
              "WSL_MEMORY": {"const": "PASS"},
              "WINDOWS_BACKING_STORAGE": {"const": "PASS"},
              "COMPOSE": {"const": "PASS"},
              "PROJECT": {"const": "PASS"},
              "NETWORKS": {"const": "PASS"},
              "PORTS": {"const": "PASS"},
              "VOLUMES": {"const": "PASS"},
              "IMAGE_APP": {"const": "PASS"},
              "IMAGE_SQL": {"const": "PASS"},
