# Nonsecret template only. Copy to .env on the PREPROD host; never commit .env.
# This increment is FOUNDATION_ONLY / NO_GO, even when health/ready passes.
PREPROD_FQDN=preprod.example.invalid
PREPROD_BIND_IP=127.0.0.1
VAULT_ADDR=https://vault.private.example.invalid:8200
TLS_CERT_FILE=/opt/fmcg-preprod/certs/tls.crt
TLS_KEY_FILE=/opt/fmcg-preprod/certs/tls.key
VAULT_API_TOKEN_FILE=/opt/fmcg-preprod/credentials/api.token
VAULT_WORKER_TOKEN_FILE=/opt/fmcg-preprod/credentials/worker.token
